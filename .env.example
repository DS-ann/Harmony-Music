# Auth0 configuration
# Copy this file to .env and fill it in. .env is git-ignored: it is a build
# asset, generated in CI from repository secrets, and never committed.
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_REDIRECT_SCHEME=harmonymusic
AUTH0_AUDIENCE=https://harmony-resolver
